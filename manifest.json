{
  "id": "notifications",
  "name": "Уведомления",
  "version": "0.3.4",
  "description": "Показывает сообщения мода и аддонов внутри клиента.",
  "modVersions": [">=0.1.0 <1.0.0"],
  "settings": [
    { "key": "duration", "type": "number", "label": "Сколько секунд показывать", "default": 4 },
    {
      "key": "position",
      "type": "select",
      "label": "Где показывать",
      "default": "bottom-right",
      "options": [
        { "value": "bottom-right", "label": "Справа внизу" },
        { "value": "top-right", "label": "Справа вверху" },
        { "value": "bottom-left", "label": "Слева внизу" }
      ]
    },
    { "key": "welcome", "type": "boolean", "label": "Сообщать о загрузке мода", "default": true }
  ]
}
